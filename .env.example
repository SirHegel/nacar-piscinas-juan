# Vercel Blob privado: Vercel lo crea al vincular el store al proyecto.
BLOB_READ_WRITE_TOKEN=

# URL absoluta de esta instalación. En Vercel puede omitirse si existe VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=

# Acceso privado al CMS/CRM. Generar estas tres variables con `npm run setup`.
# No existe usuario ni contraseña predeterminados.
ADMIN_USERNAME=
# Formato generado: <salt-hex>:<hash-scrypt-hex>. Nunca escribir la contraseña real.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Opcionales: el formulario siempre guarda en el CRM; estas vías añaden avisos externos.
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=
