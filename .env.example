ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Opcionales: el formulario siempre guarda en el CRM; estas vías añaden avisos externos.
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=
